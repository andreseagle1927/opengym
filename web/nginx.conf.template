# openGym — standalone web server: serves the static app AND proxies /api to the backend,
# so the whole app lives on ONE origin (required for WebAuthn / passkeys).
server {
    listen ${NGINX_PORT};
    root /usr/share/nginx/html;
    index index.html;

    # API → backend container
    # Admin video uploads are streamed through to the API instead of being buffered as
    # a large temporary request body by nginx.
    location = /api/admin/exercise-video {
        client_max_body_size 90m;
        client_body_timeout 10m;
        proxy_request_buffering off;
        proxy_send_timeout 10m;
        proxy_read_timeout 10m;
        proxy_pass http://${BACKEND}:${PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://${BACKEND}:${PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Shared MP4s are served as static files. nginx supports byte ranges for these
    # files by default, allowing video clients to buffer and seek on demand.
    location ^~ /exercise-videos/ {
        try_files $uri =404;
        types { video/mp4 mp4; }
        add_header Accept-Ranges bytes always;
        add_header Cache-Control "public, max-age=0, must-revalidate" always;
    }

    # Apple fetches this exact path for iOS passkey association. Proxy it to the API so
    # the response can be generated from APPLE_TEAM_ID and APPLE_IOS_CLIENT_ID.
    location = /.well-known/apple-app-site-association {
        proxy_pass http://${BACKEND}:${PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # App shell: always revalidate so updates show up immediately
    location ~* \.(js|css|json|html)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Exercise images/GIFs never change → cache hard
    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff|woff2|webp|avif)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;
    gzip_vary on;
    gzip_min_length 1024;
}
